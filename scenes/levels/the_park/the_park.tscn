shape = SubResource("RectangleShape2D_opsyf")

[node name="SpeakComponent" parent="NPCs/EnlightenedNPC" index="3" unique_id=1744893008]
dialogue = Array[String](["[b]Thinker:[/b] And to think, we're all made up of the same matter and energy that makes up our reality. We get so caught up in our minds that we've lost our senses.", "[b]Thinker:[/b] We are more than our body and conciousness. We are the [rainbow freq=2.0 sat=0.8 val=0.8 speed=0.5]universe[/rainbow] experiencing itself! Sucking air through a meat tube!", "[b]Thinker:[/b] Wake up and realize everything is nothing and the only certain thing is uncertainty. You and I [i]will[/i] die. I find that thought comforting.", "[b]Thinker:[/b] So go [shake rate=20.0 level=5 connected=1]LIVE[/shake]", "[b][rainbow freq=1.0 sat=0.8 val=0.8 speed=1.0]Jim Jar:[/rainbow][/b] [wave amp=50.0 freq=5.0 connected=1]...[/wave]", "[b][rainbow freq=1.0 sat=0.8 val=0.8 speed=1.0]Jim Jar:[/rainbow][/b] [i]Well, that made no f**king sense.[/i]"])

