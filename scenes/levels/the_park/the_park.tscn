[node name="SpeakComponent" parent="NPCs/Path2D/PathFollow2D/SaitamaNPC" index="3" unique_id=1744893008]
dialogue = Array[String](["[b]Gogima:[/b] 100 push-ups! 100 sit-ups! 100 squats! And a 10km run!", "[b]Gogima:[/b] Thats what it takes to make it!", "[b]Gogima:[/b] Stay [shake rate=20.0 level=5 connected=1]HARD![/shake]", "[b][rainbow freq=1.0 sat=0.8 val=0.8 speed=1.0]Jim Jar:[/rainbow][/b] I think I'll stick with what makes me feel fulfilled and people watch, thanks"])

