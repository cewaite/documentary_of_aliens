shape = SubResource("RectangleShape2D_fooy6")

[node name="SpeakComponent" parent="NPCs/RobberNPC" index="3" unique_id=1744893008]
dialogue = Array[String](["[b]Robber:[/b] Yo! Check it, just robbed the store down the street. Fat wads of cash in hand, saw the blues and, get this...", "[b]Robber:[/b] Walked right past! Guess they were too busy beatin' on that poor bystander they couldn't be bothered!", "[b]Robber:[/b] So, been running so hard, thought I'd have a rest and a smoke.", "[b][rainbow freq=1.0 sat=0.8 val=0.8 speed=1.0]Jim Jar:[/rainbow][/b] It's still illegal, why not give it up?", "[b]Robber:[/b] I love robbing. And in this economy?! Besides, beats working at the office's up the street from here. Now that's a strange place, that is..."])

