[node name="SpeakComponent" parent="NPCs/WeirdoNPC" index="3" unique_id=1744893008]
dialogue = Array[String](["[b]Employee?:[/b] Ever notice how there aren't any bathrooms at this office. I've just been using the janitors mop bucket (‾ ⌣ ‾)", "[b][rainbow freq=1.0 sat=0.8 val=0.8 speed=1.0]Jim Jar:[/rainbow][/b] [i]Okay, this planet is weird, but this guy is f**ked, even by human standards...[/i]", "[b]Employee?:[/b] I'm so excited for my meeting with Big Boss! I'm going to get so much praise for all my hard work!", "[b][rainbow freq=1.0 sat=0.8 val=0.8 speed=1.0]Jim Jar:[/rainbow][/b] [i]Oh, no, he's just a little dumb. Poor thing.[/i]"])

